<?xml version="1.0"?>
<package>
	<metadata>
		<id>${CPACK_PACKAGE_NAME}</id>
		<version>${PROJECT_VERSION}</version>
		<authors>${CPACK_PACKAGE_CONTACT}</authors>
		<owners>${CPACK_PACKAGE_CONTACT}</owners>
		<projectUrl>${CPACK_PROJECT_URL}</projectUrl>
		<readme>docs\readme.md</readme>
		<requireLicenseAcceptance>true</requireLicenseAcceptance>
		<license type="expression">LGPL-3.0-only</license>
		<description>${CPACK_PACKAGE_DESCRIPTION}</description>
		<copyright>Copyright ${CPACK_PACKAGE_CONTACT}</copyright>
	</metadata>
	<files>
		<file src="build\" target="build" />
		<file src="include\" target="include" />
		<file src="share\" target="share" />
		<file src="${CMAKE_INSTALL_DOCDIR}\readme.md" target="docs\" />
	</files>
</package>
